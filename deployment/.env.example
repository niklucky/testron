# Copy to .env.production. Literal KEY=value, no shell expansion.
# Environment variables override this file. Relative key paths are relative
# to this directory. Run the entry point from your workstation.
SSH_TARGET=testron
# Leave empty to honor your SSH config (port, user, identity, ProxyJump, etc.).
SSH_PORT=
# Optional private key used locally for provisioning AND developer login check.
# SSH_IDENTITY_FILE=/Users/you/.ssh/id_ed25519
DEPLOY_KEY_FILE=github_id_rsa.pub
DEVELOPER_KEYS_FILE=developer_keys.pub
DEVELOPER_USER=developer
PERMIT_ROOT_LOGIN=prohibit-password
CERT_EMAIL=you@example.com
# Set 1 only if www also points at this server and should get a certificate.
INCLUDE_WWW=0
# Optional. Empty disables the read-only translation relay with HTTP 503.
SLANG_API_KEY=
