{
  "name": "testron",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "start": "pnpm --filter @testron/desktop start",
    "start:fixture": "pnpm --filter @testron/test-fixtures start",
    "start:server": "pnpm --filter @testron/server start",
    "dev:server": "pnpm --filter @testron/server dev",
    "dev:desktop": "pnpm --filter @testron/desktop start:app",
    "dev:webapp": "pnpm --filter @testron/webapp dev",
    "dev": "concurrently -n server,webapp \"pnpm dev:server\" \"pnpm dev:webapp\"",
    "build:webapp": "pnpm --filter @testron/webapp build",
    "dev:web": "pnpm --filter @testron/web dev",
    "build:web": "pnpm --filter @testron/web build",
    "compose:up": "docker compose -f compose.local.yml up --detach --wait",
    "compose:down": "docker compose -f compose.local.yml down",
    "test:db:up": "docker compose -f compose.test.yml up --detach --wait",
    "test:db:down": "docker compose -f compose.test.yml down --volumes",
    "server:db:generate": "pnpm --filter @testron/server db:generate",
    "server:db:migrate": "pnpm --filter @testron/server db:migrate",
    "build": "pnpm --filter @testron/webapp build && pnpm --filter @testron/desktop build",
    "package": "pnpm --filter @testron/desktop package",
    "make": "pnpm --filter @testron/desktop make",
    "make:win": "pnpm --filter @testron/desktop make:win",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --recursive --if-present test",
    "test:replay": "pnpm --filter @testron/test-fixtures test:replay",
    "test:electron": "pnpm --filter @testron/desktop test:electron",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "concurrently": "^10.0.5",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
