# Copy this file to .env for local server development.
DATABASE_URL=postgresql://testron:testron@127.0.0.1:55432/testron
HOST=127.0.0.1
PORT=4400
TESTRON_PUBLIC_URL=http://127.0.0.1:4400

# Required before creating project secrets or reusable server browser state.
# The highest version encrypts new values; retain older versions for key rotation.
# Generate a key with: openssl rand -base64 32
# TESTRON_AUTH_ENCRYPTION_KEYS=1:replace-with-32-byte-base64-key

# Server Playwright runs. Cron schedules are always evaluated in UTC.
TESTRON_ARTIFACTS_DIR=./data/artifacts
TESTRON_RUN_TIMEOUT_MS=60000
# Extra public origins needed by tests (CDNs, API hosts, identity providers).
# The selected environment origin is already permitted. Private/reserved IPs
# remain blocked, even for listed origins. Comma-separated; no paths/wildcards.
# TESTRON_RUNNER_ALLOWED_ORIGINS=https://cdn.example.com,https://login.example.com

# Optional invitation and password-reset email delivery through Resend. Configure both values.
# RESEND_API_KEY=re_xxxxxxxxx
# RESEND_FROM_EMAIL=Testron <invites@example.com>

# Optional alpha bootstrap account.
# TESTRON_BOOTSTRAP_EMAIL=owner@example.com
# TESTRON_BOOTSTRAP_PASSWORD=replace-me
